<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>iDaVIE.SonarAnalysis</AssemblyName>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <NoWarn>CS0618;CS0162;CS0649;CS0414;CS0169;CS8019</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="ci/sonar/UnityAnalysisStubs.cs" />
    <Compile Include="ci/sonar/AnalysisDependencyStubs.cs" />
    <Compile Include="Assets/Scripts/Tools/ColorMapEnum.cs" />
    <Compile Include="Assets/Scripts/PluginInterface/**/*.cs" />
    <Compile Include="Assets/Scripts/VolumeData/VolumeDataSet.cs" />
    <Compile Include="Assets/Scripts/VolumeData/VolumeDataSetRenderer.cs" />
    <Compile Include="Assets/Scripts/VolumeData/VolumeInputController.cs" />
    <Compile Include="Assets/Scripts/VolumeData/VolumeCommandController.cs" />
    <Compile Include="Assets/Scripts/VolumeData/MomentMapRenderer.cs" />
    <Compile Include="Assets/Scripts/Tools/Delegates.cs" />
    <Compile Include="Assets/Scripts/Tools/BenchmarkManager.cs" />
    <Compile Include="Assets/Scripts/VolumeData/Config.cs" />
    <Compile Include="Assets/Scripts/Menu/QuickMenuController.cs" />
    <Compile Include="Assets/Scripts/Menu/PaintMenuController.cs" />
    <Compile Include="Assets/Scripts/Menu/SourceRow.cs" />
    <Compile Include="Assets/Scripts/Menu/TabsManager.cs" />
    <Compile Include="Assets/Scripts/VoiceCommands/**/*.cs" />
    <Compile Include="Assets/Scripts/FeatureData/**/*.cs" />
    <Compile Include="Assets/Scripts/UI/CanvassDesktop.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets/Resources/MomentMapGenerator.compute" />
    <Content Include="Assets/Shaders/Volumes/**/*" />
    <Content Include="Assets/Prefabs/DesktopGUI/**/*.prefab" />
  </ItemGroup>
</Project>
