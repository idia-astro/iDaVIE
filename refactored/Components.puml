' ══════════════════════════════════════════════════════════════════════════
' refactored/Persistence/  — ST7 (greenfield; Application / Domain layered)
' ══════════════════════════════════════════════════════════════════════════

package "refactored/Persistence/  (ST7)" #FBE9E7 {

  component "WorkspaceService\n«internal sealed»\n(SOLE realiser of all four\nST7 contracts — wired by\nPersistenceCompositionRoot)" as WS
  component "PersistenceCompositionRoot" as PCR
  component "PersistenceMenuController\n«MonoBehaviour»" as PMC

  package "Application (helper)" #FFFFFF {
    component "ValidationAndRecoveryService\n(integrity / migration / rollback;\nnot yet wired into WorkspaceService)" as VRS
  }
  package "Domain" #FFFFFF {
    component "StoredState / StateIndex /\nStorageLocation / IntegrityRecord /\nPersistenceLog / PersistenceConfig /\nMigrationRule" as PDOM
    component "WorkspaceRepository\n+ WorkspaceEnvelope" as WREPO
  }

  interface "IWorkspaceSaveCommand" as I_WSave
  interface "IWorkspaceLoadCommand" as I_WLoad
  interface "IStateIndexQuery"      as I_WIdx
  interface "IPersistenceEvents"    as I_WEvt
  WS -up- I_WSave
  WS -up- I_WLoad
  WS -up- I_WIdx
  WS -up- I_WEvt

  PCR ..> WS : composes
  WS ..> WREPO
  note bottom of WS
    WorkspaceService is now the single realiser of the four ST7 contracts:
    the parallel Application use-cases (SaveUseCase / LoadUseCase /
    StateManagementService / PersistenceEventDispatcher) that re-realised
    them have been removed. Contracts are also declared exactly once, in
    PersistenceContracts.cs.
  end note
}

' ══════════════════════════════════════════════════════════════════════════
' External/ — reference declarations only (reproduced contract shape)
' ══════════════════════════════════════════════════════════════════════════
note as N_External
  refactored/External/ holds two reference-declaration files —
  IVolumeDataSet.cs (→ iDaVIE.Kernel.Contracts: IVolumeDataSet,
  IMaskEditState, IRawVoxelAccess) and ICoordinateTransformer.cs
  (→ iDaVIE.Data: ICoordinateTransformer, IMaskMutationService,
  IFitsMaskWriter, IFitsCubeReader). They reproduce ST1/ST2 contract
  shape so the ST3/ST5 skeletons compile-as-illustrated; ownership stays
  with ST1 / ST2, hence they are drawn inside Kernel / Data above.
end note

