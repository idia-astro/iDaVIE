@startuml refactored_Components
skinparam dpi 80

' UML Component Diagram — refactored/ skeletons.
'
' Scope:
'   Every component shipped under refactored/ as a black box with its provided
'   (lollipop) and required (socket / dependency) interfaces. After the Tier-1
'   push (see info/README.md) all seven sub-teams are skeleton-ported, so all
'   seven worked packages are now first-class:
'       Kernel/       (ST1)   Data/        (ST2)   Rendering/   (ST3)
'       Interaction/  (ST4)   Features/    (ST5)   UI/          (ST6)
'       Persistence/  (ST7)
'   External/ no longer hosts ST1/ST2 as black boxes — it is now just the two
'   reference-declaration files (IVolumeDataSet, ICoordinateTransformer) that
'   reproduce kernel/data contract shape so the skeletons compile-as-illustrated;
'   those types belong to iDaVIE.Kernel.Contracts / iDaVIE.Data and are drawn
'   inside the Kernel and Data packages here.
'
' Reading order:
'   - Lollipop on a component edge       = provided interface (realised here).
'   - Socket / labelled ..> on a consumer = required interface (injected at a
'                                            composition root).
'   - «internal» on an interface label    = scoped to the owning assembly (DD-5);
'                                            cross-team consumers may not bind it.
'   - A realisation line crossing a package edge = the interface is DECLARED by
'                                            one team and REALISED by another
'                                            (e.g. IVolumeDataSet declared ST1,
'                                            realised by ST3's VolumeDataSet).

skinparam componentBackgroundColor #FAFAFA
skinparam componentBorderColor #444
skinparam interfaceBackgroundColor #FFFFFF
skinparam interfaceBorderColor #444
skinparam packageBackgroundColor #FFFFFF
skinparam linetype polyline
hide stereotype

' ══════════════════════════════════════════════════════════════════════════
' refactored/Kernel/  — ST1 (kernel, shared contracts, composition root)
' ══════════════════════════════════════════════════════════════════════════

package "refactored/Kernel/  (ST1)" #ECEFF1 {

  component "KernelCompositionRoot\n(global root — sole new() site;\nBootstrap wires ST1→…→ST7)" as KCR
  component "Config\n«internal sealed»" as CFG
  component "PluginRegistry\n«internal sealed»" as PREG

  ' Contracts declared by ST1 (Kernel/Contracts/** + External/ reference decls).
  interface "IConfig"             as I_Cfg
  interface "IPluginRegistry"     as I_PReg
  interface "IVolumeRegistry"     as I_VReg
  interface "IVolumeLoader"       as I_VLoad
  interface "ILogSink"            as I_Log
  interface "IDesktopShell"       as I_Shell
  interface "IVolumeStateCapture" as I_VCap
  interface "IVolumeDataSet\n(decl ST1 — realised ST3)" as I_Vol
  interface "IRawVoxelAccess\n(decl ST1 — realised ST2)" as I_Raw
  interface "IMaskEditState\n(decl ST1 — realised ST2)"  as I_MaskEdit
  interface "IFitsPlugin\n+ IWcsPlugin\n(decl ST1 — realised ST2)" as I_PluginAbi

  CFG  -up- I_Cfg
  PREG -up- I_PReg
  note bottom of KCR
    Exposes IVolumeRegistry / IVolumeLoader / ILogSink / IDesktopShell as
    facade properties. Concrete IVolumeRegistry + IVolumeLoader are built in
    Bootstrap (no skeleton class); ILogSink realised by DebugLogging (Tier-3);
    IDesktopShell realised by ST6 CanvassDesktop. Boundary value-types
    (CartesianCoord, VolumeExtents, DataStats, HistogramData, AxisUnits …)
    live in Kernel/BoundaryValueTypes.cs and are used by every team.
  end note
}

' ══════════════════════════════════════════════════════════════════════════
' refactored/Data/  — ST2 (FITS / WCS / DataAnalysis plug-in adapters)
' ══════════════════════════════════════════════════════════════════════════

package "refactored/Data/  (ST2)" #E1F5FE {

  component "FitsReaderPlugin\n«internal sealed»\n(CFITSIO ACL)" as FITS
  component "WcsTransformPlugin\n«internal sealed»\n(Starlink AST ACL)" as WCS
  component "DataAnalysisPlugin\n«internal sealed»" as DAN
  component "MaskEditService\n«internal sealed»" as MEDIT
  component "NativePluginLoader\n(infrastructure)" as NPL

  interface "ICoordinateTransformer" as I_Coords
  interface "ISourceStatsProvider"   as I_Stats
  interface "IDataAnalysisPlugin"    as I_DAP
  interface "IMaskMutationService"   as I_MaskMut
  interface "IBrushStrokeHistory"    as I_Brush
  interface "IMaskStateCapture"      as I_MaskCap
  interface "IFitsMaskWriter\n+ IFitsCubeReader" as I_FitsIO
  interface "IFitsBinaryTableSource\n«internal»" as I_FitsTbl

  FITS  -up- I_PluginAbi
  FITS  -up- I_Raw
  FITS  -up- I_FitsTbl
  FITS  .up.> I_FitsIO : <<FITS write/read\n— realiser TBD>>
  WCS   -up- I_PluginAbi
  WCS   -up- I_Coords
  DAN   -up- I_Stats
  DAN   -up- I_DAP
  MEDIT -up- I_MaskMut
  MEDIT -up- I_MaskEdit
  MEDIT -up- I_Brush
  MEDIT -up- I_MaskCap
}

' ══════════════════════════════════════════════════════════════════════════
' refactored/Rendering/  — ST3
' ══════════════════════════════════════════════════════════════════════════

package "refactored/Rendering/  (ST3)" #E3F2FD {

  ' ── Unity ACL — thin MonoBehaviour composing the four §6.3 splits ────────
  component "VolumeDataSetRenderer\n«MonoBehaviour»\n(~120 LOC, composes splits)" as VDR

  ' ── §6.3 mandated splits ─────────────────────────────────────────────────
  component "VolumeMaterialBinder" as VMB
  component "VolumeTextureManager\n(owns Material + Texture3D;\nexposes IMaskGpuBuffers)" as VTM
  component "VolumeCameraDriver" as VCD
  component "FoveatedSamplingPolicy" as FSP
  component "MaskModeRegistry\n+ {Disabled/Enabled/\n  Inverted/Isolated}MaskMode" as MMR
  interface "IMaskMode «internal»"      as I_MaskMode
  interface "IMaskGpuBuffers «internal»" as I_MaskBuf
  MMR -up- I_MaskMode
  VTM -up- I_MaskBuf

  ' ── Unnamed-by-§6.3 services (Unity-free) ────────────────────────────────
  component "VolumeCoordinateService" as VCS
  component "RegionSelection" as REG
  component "MaskEditingService" as MES
  component "VolumePersistenceService" as VPS
  interface "IRegionSelection «internal»" as I_Reg
  REG -up- I_Reg

  ' ── Kernel contract realised here (ST3 owns the domain aggregate) ────────
  component "VolumeDataSet\n«internal sealed»\n(realises ST1 IVolumeDataSet)" as VDS
  VDS .up.> I_Vol

  ' ── Other ST3 concretes ──────────────────────────────────────────────────
  component "MomentMapRenderer\n«MonoBehaviour»" as MMRND
  component "CatalogDataSetRenderer\n«MonoBehaviour»" as CDR
  component "HistogramService\n«internal sealed»" as HSV

  ' ── ST3 cross-team contracts (Rendering/Contracts) ───────────────────────
  interface "IRenderSettings\n+ IRenderSettingsMutator" as I_RSet
  interface "IRenderStateCapture"     as I_RCap
  interface "IMomentMapRenderer"      as I_MMR
  interface "IHistogramService"       as I_Hist
  interface "IRestFrequencyCatalogue" as I_RFC
  component "RenderSettings\n(composition-root POCO)" as RSET
  RSET -up- I_RSet
  RSET .up.> I_RCap
  RSET .up.> I_RFC : <<reads Config>>
  MMRND -up- I_MMR
  HSV   -up- I_Hist

  ' ── §6.3 composition ─────────────────────────────────────────────────────
  VDR ..> VMB
  VDR ..> VTM
  VDR ..> VCD
  VDR ..> FSP
  VDR ..> MMR
  VCD ..> I_Reg
  MES ..> I_Reg
  REG ..> VCS : <<coord maths>>
}

' ══════════════════════════════════════════════════════════════════════════
' refactored/Interaction/  — ST4
' ══════════════════════════════════════════════════════════════════════════

package "refactored/Interaction/  (ST4)" #FFF3E0 {

  component "VolumeInputController\n«MonoBehaviour»\n(thin dispatcher)" as VIC
  component "VolumeCommandController\n«MonoBehaviour»" as VCC
  component "QuickMenuController\n+ PaintMenuController\n«MonoBehaviour»" as QMP
  component "ShapeMenuController\n«MonoBehaviour»" as SMC
  component "InteractionStateManager\n«MonoBehaviour»" as ISM

  ' ── Pure-C# FSMs (no UnityEngine) ────────────────────────────────────────
  component "LocomotionFSM\n+ {Idle/Moving/\n  ScalingRotating}State" as LFSM
  component "InteractionFSM\n+ Drag/Shape gesture state" as IFSM
  component "ShapeGestureFSM" as SGF

  ' ── ACL adapters realising platform-neutral streams ──────────────────────
  component "ControllerInputAdapter\n«MonoBehaviour» (ACL)" as CIA
  component "VoiceCommandService\n«internal sealed»\n+ VoiceCommandRegistry" as VCSV
  component "KeypadInputAdapter\n«MonoBehaviour»" as KIA

  interface "IControllerEventStream"    as I_Ctrl
  interface "IVoiceCommandStream"       as I_Voice
  interface "IInteractionStateProvider" as I_ISP
  interface "IInteractionStateCapture"  as I_ISCap
  CIA  -up- I_Ctrl
  VCSV -up- I_Voice
  ISM  -up- I_ISP
  ISM  -up- I_ISCap

  VIC ..> LFSM
  VIC ..> IFSM
  VIC ..> ISM
  IFSM ..> VCC : <<commits via>>
  SMC ..> SGF
}

' ══════════════════════════════════════════════════════════════════════════
' refactored/Features/  — ST5  (Domain / Application / Infrastructure / ACL)
' ══════════════════════════════════════════════════════════════════════════

package "refactored/Features/  (ST5)" #E8F5E9 {

  package "Domain" #FFFFFF {
    component "Feature / FeatureSet /\nFeatureStatistics" as FAGG
    component "CartesianCoordOps\n«utility»" as CCO
    interface "IFeature"           as I_Feat
    interface "IFeatureSet"        as I_FSet
    interface "IFeatureStatistics" as I_FStats
    interface "IFeatureDirtyListener «internal»" as I_Dirty
    FAGG -up- I_Feat
    FAGG -up- I_FSet
    FAGG -up- I_FStats
    FAGG ).. I_Dirty : notifies
    FAGG ..> CCO
  }

  package "Application" #FFFFFF {
    component "FeatureSetService\n(IFeatureSetQuery +\nIFeatureSetCatalog +\nIFeatureStateCapture)" as FSS
    component "FeatureFactory" as FAC
    component "FeatureImportService\n(+ IImportRestorer)" as FIS
    component "SelectionService" as SEL
    component "SpectralProfileService" as SPS
    component "MomentMapServiceAdapter" as MMSA

    interface "IFeatureSetQuery"          as I_FSQ
    interface "IFeatureSelectionService"  as I_FSel
    interface "IFeatureStateCapture"      as I_FSCap
    interface "IFeatureImportService"     as I_FIS
    interface "ISpectralProfileService"   as I_SPS
    interface "IMomentMapService"         as I_MMS
    interface "IActiveFeatureSetTypeProvider" as I_Active
    interface "IFeatureFactory «internal»"    as I_Fac
    interface "IFeatureSetCatalog «internal»" as I_FSC
    interface "IImportRestorer «internal»"    as I_Restore
    interface "IVisualiserBinder «internal»"  as I_Bind
    interface "ISelectionVisualiser «internal»" as I_SelVis

    FSS -up- I_FSQ
    FSS -up- I_FSCap
    FSS -up- I_FSC
    FAC -up- I_Fac
    FIS -up- I_FIS
    FIS -up- I_Restore
    SEL -up- I_FSel
    SPS -up- I_SPS
    MMSA -up- I_MMS
  }

  package "Infrastructure" #FFFFFF {
    component "VoTableReader\n+ FitsTableReader" as CRead_Impl
    component "VoTableSaver" as VOS
    interface "IFeatureCatalogueReader" as I_CRead
    interface "IFeatureCatalogueWriter" as I_CWrite
    CRead_Impl -up- I_CRead
    VOS -up- I_CWrite
  }

  package "Unity ACL" #FFFFFF {
    component "FeatureVisualiser\n«MonoBehaviour»\n(owns ComputeBuffer;\nrealises IFeatureDirtyListener)" as FV
    component "SelectionAnchorRenderer\n«MonoBehaviour»" as SAR
    FV  .up.> I_Dirty
    SAR -up- I_SelVis
    FV  .up.> I_Bind : <<binder hands per-set listener back>>
  }
}

