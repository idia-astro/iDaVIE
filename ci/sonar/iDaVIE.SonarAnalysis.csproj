<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <NoWarn>$(NoWarn);CS0649;CS0169;CS8618</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="OxyPlot.Core" Version="2.1.0" />
    <Compile Include="UnityAnalysisStubs.cs" />
    <Compile Include="../../Assets/Scripts/**/*.cs"
             Exclude="../../Assets/Scripts/PluginInterface/NativePluginLoader.cs;../../Assets/Scripts/Menu/VideoRecPointListController.cs;../../Assets/Scripts/Menu/HistogramHelper.cs"
             Link="Assets/Scripts/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>